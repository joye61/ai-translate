<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AiTranslate.Desktop"
             x:Class="AiTranslate.Desktop.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFF8F5F1" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFF1ECE6" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFDDD5CB" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FFC9BFB2" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FFC9BFB2" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#FFFF7A59" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FFEDE8E1" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFDDD5CB" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FFC9BFB2" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFFF7A59" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFF8F5F1" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
                    <!-- Off toggles: warm-gray track and knob instead of Fluent's near-black outline. -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FFF8F5F1" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FFF1ECE6" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FFC9BFB2" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#FFAFA396" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#FFAFA396" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF8F867C" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FF5E564D" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FF5E564D" />
                    <SolidColorBrush x:Key="ProgressBarBackground" Color="#FFEDE8E1" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light"
                                       Accent="#FFFF7A59"
                                       RegionColor="#FFFAF8F5"
                                       ErrorText="#FFC0283A" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Button also covers checkboxes and switches. ComboBoxItem derives from ListBoxItem. -->
        <Style Selector=":is(Button):pointerover:not(:disabled), ComboBox:pointerover:not(:disabled),
                         :is(ListBoxItem):pointerover:not(:disabled), MenuItem:pointerover:not(:disabled),
                         TabItem:pointerover:not(:disabled)">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Button states. Fluent's template overrides a locally-set Background on hover/press, which would
             leave white-on-gray text unreadable, so every button role declares its own state colors via a class. -->
        <Style Selector="Border.chat-composer">
            <Setter Property="BorderBrush" Value="{x:Static local:AppTheme.BorderStrong}" />
        </Style>
        <Style Selector="Border.chat-composer:focus-within">
            <Setter Property="BorderBrush" Value="{x:Static local:AppTheme.Accent}" />
        </Style>
        <Style Selector="TextBox.chat-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{x:Static local:AppTheme.CardBg}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Quiet "chip" selectors (composer): warm-gray pill, no border, hover/press tint only. -->
        <Style Selector="ComboBox.chip">
            <Setter Property="Background" Value="{x:Static local:AppTheme.InputBg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="11,0,4,0" />
        </Style>
        <Style Selector="ComboBox.chip:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{x:Static local:AppTheme.HoverBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.chip:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{x:Static local:AppTheme.PressedBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.chip /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{x:Static local:AppTheme.TextMuted}" />
            <Setter Property="Width" Value="10" />
        </Style>

        <Style Selector="Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.CardElevatedBg}" />
        </Style>
        <Style Selector="Button.compact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.PressedBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.compact local|MdiIcon">
            <Setter Property="Foreground" Value="{x:Static local:AppTheme.TextSecondary}" />
        </Style>
        <Style Selector="Button.compact TextBlock">
            <Setter Property="Foreground" Value="{x:Static local:AppTheme.TextSecondary}" />
        </Style>
        <Style Selector="Button.compact:pointerover local|MdiIcon">
            <Setter Property="Foreground" Value="{x:Static local:AppTheme.TextPrimary}" />
        </Style>
        <Style Selector="Button.compact:pointerover TextBlock">
            <Setter Property="Foreground" Value="{x:Static local:AppTheme.TextPrimary}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.AccentHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.AccentPressed}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.EmeraldHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.success:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.EmeraldHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.HoverBg}" />
            <Setter Property="BorderBrush" Value="{x:Static local:AppTheme.BorderStrong}" />
        </Style>
        <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.PressedBg}" />
            <Setter Property="BorderBrush" Value="{x:Static local:AppTheme.BorderStrong}" />
        </Style>

        <Style Selector="Button.speech local|MdiIcon">
            <Setter Property="Foreground" Value="{x:Static local:AppTheme.TextSecondary}" />
        </Style>
        <Style Selector="Button.speech.playing /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.AccentSoft}" />
            <Setter Property="BorderBrush" Value="{x:Static local:AppTheme.Accent}" />
        </Style>
        <Style Selector="Button.speech.playing local|MdiIcon">
            <Setter Property="Foreground" Value="{x:Static local:AppTheme.AccentBright}" />
        </Style>
        <Style Selector="Button.caption local|MdiIcon">
            <Setter Property="Foreground" Value="{x:Static local:AppTheme.TextPrimary}" />
        </Style>
        <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.caption-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.Danger}" />
        </Style>
        <Style Selector="Button.caption-close:pointerover local|MdiIcon, Button.caption-close:pressed local|MdiIcon">
            <Setter Property="Foreground" Value="{x:Static local:AppTheme.CardBg}" />
        </Style>
        <Style Selector="StackPanel.traffic-lights:not(:pointerover):not(:focus-within) local|MdiIcon">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="StackPanel.traffic-lights Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, StackPanel.traffic-lights Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="StackPanel.traffic-lights Button:pressed Border">
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <Style Selector="Button.tint:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.AccentSoft}" />
        </Style>
        <Style Selector="Button.tint:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.AccentSoft}" />
        </Style>

        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.HoverBg}" />
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.PressedBg}" />
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.AccentSoft}" />
        </Style>
        <Style Selector="Button.nav.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.AccentSoft}" />
        </Style>

        <!-- List rows: neutral hover, quiet accent-soft selection (same language as the active nav row). -->
        <Style Selector="ListBox.entries ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.HoverBg}" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.AccentSoft}" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.AccentSoft}" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static local:AppTheme.AccentSoft}" />
        </Style>
    </Application.Styles>
</Application>
